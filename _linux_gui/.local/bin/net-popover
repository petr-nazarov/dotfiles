#!/usr/bin/python3
"""Waybar's Wi-Fi, Bluetooth, Sound, VPN and Dictation panels: a macOS-style card under the bar icon.

`net-popover wifi|bluetooth|sound|vpn|dictation|system` shows that panel, or hides it when it is already
showing. The first call starts a resident GTK app; later calls only send it a D-Bus message, so
a click opens the card at once. Wi-Fi talks to iwd and Bluetooth to bluez over the system bus,
Sound to PipeWire through pactl; impala, bluetui and wiremix stay one click away in each panel's
footer. VPN drives Tailscale and NetBird, and Dictation voxtype, through the same scripts the bar's
icons use; their checks can take seconds (server health pings), so they load in the background.
System shows live CPU and memory use, the auto-sleep switch (sleep-toggle) and the power actions.

The card sits on a transparent layer that covers the screen below the bar, so a click anywhere
outside it (or Escape) closes it, and clicking the bar icon again toggles it.
"""

import ctypes
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from urllib.parse import urlparse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

APP_ID = "dev.nazarov.NetPopover"
APP_PATH = "/dev/nazarov/NetPopover"
VIEWS = ("wifi", "bluetooth", "sound", "vpn", "dictation", "system")
SLOW_VIEWS = ("vpn", "dictation", "system")  # state fetched off the main thread, then polled while open


def forward_to_running(view):
    """Toggle the panel in an already running instance; False when none is running."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(
            APP_ID,
            APP_PATH,
            "org.freedesktop.Application",
            "ActivateAction",
            GLib.Variant("(sava{sv})", ("toggle", [GLib.Variant("s", view)], {})),
            None,
            Gio.DBusCallFlags.NO_AUTO_START,
            1000,
            None,
        )
        return True
    except GLib.Error:
        return False


if __name__ == "__main__":
    VIEW = sys.argv[1] if len(sys.argv) > 1 else "wifi"
    if VIEW not in VIEWS:
        sys.exit(f"usage: net-popover {{{'|'.join(VIEWS)}}}")
    if forward_to_running(VIEW):
        sys.exit(0)

