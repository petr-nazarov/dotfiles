def unpack(variant):
    return variant.unpack() if variant is not None else None


def label(text, *classes, xalign=0.0, hexpand=False):
    widget = Gtk.Label(label=text, xalign=xalign, hexpand=hexpand)
    widget.set_ellipsize(3)  # Pango.EllipsizeMode.END
    for css in classes:
        widget.add_css_class(css)
    return widget


def hbox(spacing=10, *children):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)
    for child in children:
        box.append(child)
    return box


def vbox(spacing=0, *children):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    for child in children:
        box.append(child)
    return box


def icon(glyph, active=False):
    widget = Gtk.Label(label=glyph, xalign=0.5, yalign=0.5, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    widget.add_css_class("icon")
    if active:
        widget.add_css_class("active")
    return widget


def spinner():
    widget = Gtk.Spinner(spinning=True)
    widget.set_size_request(14, 14)
    return widget


def unfocusable(widget):
    """The card takes the keyboard while open (for the Wi-Fi password box); keep Space and Enter
    typed into it from toggling switches or pressing rows."""
    widget.set_focusable(False)
    widget.set_focus_on_click(False)
    return widget


def row(children, on_click, tooltip=None):
    button = unfocusable(Gtk.Button(child=hbox(10, *children)))
    button.add_css_class("row")
    button.connect("clicked", lambda _b: on_click())
    if tooltip:
        button.set_tooltip_text(tooltip)
    return button


def title_block(title, subtitle=None, error=False):
    box = vbox(0, label(title, hexpand=True))
    box.set_hexpand(True)
    box.set_valign(Gtk.Align.CENTER)
    if subtitle:
        sub = label(subtitle, "sub")
        if error:
            sub.add_css_class("error")
        box.append(sub)
    return box


def pill(text, on_click, accent=False):
    button = unfocusable(Gtk.Button(label=text, valign=Gtk.Align.CENTER))
    button.add_css_class("pill")
    if accent:
        button.add_css_class("accent")
    button.connect("clicked", lambda _b: on_click())
    return button


def section(text, extra=None):
    box = hbox(6, label(text, "section", hexpand=True))
    if extra:
        box.append(extra)
    box.set_margin_start(10)
    box.set_margin_end(10)
    box.set_margin_top(6)
    box.set_margin_bottom(2)
    return box


def run_tui(command):
    subprocess.Popen([os.path.join(BIN, "run-in-new-term"), command], start_new_session=True)


def band(mhz):
    if not mhz:
        return ""
    return "6 GHz" if mhz >= 5925 else "5 GHz" if mhz >= 4900 else "2.4 GHz"


def wifi_bars(dbm):
    if dbm is None:
        return WIFI_BARS[0]
    return WIFI_BARS[3 if dbm >= -55 else 2 if dbm >= -65 else 1 if dbm >= -75 else 0]


def first_line(command):
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return out.splitlines()[0] if out.strip() else ""


def ip_details(ifname):
    """(IPv4 address, default router) of an interface, empty strings when unknown."""
    addr = first_line(["ip", "-4", "-o", "addr", "show", "dev", ifname]).split()
    address = addr[3].split("/")[0] if len(addr) > 3 else ""
    route = first_line(["ip", "-4", "route", "show", "default", "dev", ifname]).split()
    router = route[2] if len(route) > 2 and route[1] == "via" else ""
    return address, router


class Bus:
    """Thin helpers over the system bus."""

    def __init__(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SYSTEM)

    def objects(self, service):
        try:
            reply = self.conn.call_sync(service, "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
                                        None, None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            return {}
        return reply.unpack()[0]

    def call_sync(self, service, path, iface, method, params=None):
        try:
            return unpack(self.conn.call_sync(service, path, iface, method, params, None,
                                              Gio.DBusCallFlags.NONE, 2000, None))
        except GLib.Error:
            return None

    def call(self, service, path, iface, method, params=None, done=None, timeout=60000):
        """Async call; done(error_message_or_None) runs when it returns."""

        def finish(conn, result):
            try:
                conn.call_finish(result)
                error = None
            except GLib.Error as err:
                Gio.DBusError.strip_remote_error(err)
                error = err.message or "Failed"
            if done:
                done(error)

        self.conn.call(service, path, iface, method, params, None, Gio.DBusCallFlags.NONE, timeout, None, finish)

    def set_prop(self, service, path, iface, prop, value, done=None):
        self.call(service, path, "org.freedesktop.DBus.Properties", "Set",
                  GLib.Variant("(ssv)", (iface, prop, value)), done, timeout=10000)

    def watch(self, service, callback):
        self.conn.signal_subscribe(service, None, None, None, None, Gio.DBusSignalFlags.NONE,
                                   lambda *_args: callback())


class Wifi:
    """iwd state and actions for the first Wi-Fi device."""

    def __init__(self, bus):
        self.bus = bus
        self.pending_passphrase = {}  # network path -> passphrase typed in the card
        self.agent_id = None
        self.agent_info = Gio.DBusNodeInfo.new_for_xml(AGENT_XML).interfaces[0]

    def state(self):
        objects = self.bus.objects(IWD)
        device_path = next((p for p, ifaces in objects.items() if f"{IWD}.Device" in ifaces), None)
        if device_path is None:
            return None
        device = objects[device_path][f"{IWD}.Device"]
        station = objects[device_path].get(f"{IWD}.Station")
        info = {"device": device_path, "ifname": device.get("Name", ""), "adapter": device.get("Adapter"),
                "powered": bool(device.get("Powered")) and station is not None, "networks": [],
                "scanning": False, "state": "", "current": None}
        if not info["powered"]:
            return info
        info["scanning"] = bool(station.get("Scanning"))
        info["state"] = station.get("State", "")
        info["current"] = station.get("ConnectedNetwork")
        ordered = self.bus.call_sync(IWD, device_path, f"{IWD}.Station", "GetOrderedNetworks") or ([],)
        for path, signal in ordered[0]:
            props = objects.get(path, {}).get(f"{IWD}.Network")
            if not props:
                continue
            info["networks"].append({
                "path": path, "name": props.get("Name", ""), "type": props.get("Type", ""),
                "known": props.get("KnownNetwork"), "connected": bool(props.get("Connected")),
                "dbm": signal / 100,
            })
        return info

    def diagnostics(self, device_path):
        reply = self.bus.call_sync(IWD, device_path, f"{IWD}.StationDiagnostic", "GetDiagnostics")
        return reply[0] if reply else {}

    def set_powered(self, info, on, done):
        def power_device(_error=None):
            self.bus.set_prop(IWD, info["device"], f"{IWD}.Device", "Powered", GLib.Variant("b", on), done)

        if on and info.get("adapter"):
            # an adapter switched off (rfkill) keeps the device off: power it first
            self.bus.set_prop(IWD, info["adapter"], f"{IWD}.Adapter", "Powered", GLib.Variant("b", True),
                              power_device)
        else:
            power_device()

    def scan(self, device_path):
        self.bus.call(IWD, device_path, f"{IWD}.Station", "Scan")

    def disconnect(self, device_path, done):
        self.bus.call(IWD, device_path, f"{IWD}.Station", "Disconnect", done=done)

    def forget(self, known_path, done):
        self.bus.call(IWD, known_path, f"{IWD}.KnownNetwork", "Forget", done=done)

    def connect(self, network_path, passphrase, done):
        """Connect, answering iwd's passphrase request with the given one (None for known/open networks).

        iwd allows a single agent and impala registers its own while it runs, so ours only exists
        for the length of a connection attempt.
        """
        if passphrase is not None:
            self.pending_passphrase[network_path] = passphrase
        self._register_agent()

        def finished(error):
            self.pending_passphrase.pop(network_path, None)
            self._unregister_agent()
            done(error)

        self.bus.call(IWD, network_path, f"{IWD}.Network", "Connect", done=finished)

    def _register_agent(self):
        if self.agent_id is not None:
            return
        try:
            self.agent_id = self.bus.conn.register_object(AGENT_PATH, self.agent_info, self._agent_call, None, None)
        except GLib.Error:
            return
        self.bus.call(IWD, "/net/connman/iwd", f"{IWD}.AgentManager", "RegisterAgent",
                      GLib.Variant("(o)", (AGENT_PATH,)))

    def _unregister_agent(self):
        if self.agent_id is None:
            return
        self.bus.call(IWD, "/net/connman/iwd", f"{IWD}.AgentManager", "UnregisterAgent",
                      GLib.Variant("(o)", (AGENT_PATH,)))
        self.bus.conn.unregister_object(self.agent_id)
        self.agent_id = None

    def _agent_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "RequestPassphrase":
            passphrase = self.pending_passphrase.get(params.unpack()[0])
            if passphrase is not None:
                invocation.return_value(GLib.Variant("(s)", (passphrase,)))
                return
        if method in ("Release", "Cancel"):
            invocation.return_value(None)
            return
        # no passphrase typed (a known network whose password changed) or enterprise Wi-Fi
        invocation.return_dbus_error(f"{IWD}.Agent.Error.Canceled", "Password needed")


class Bluetooth:
    """bluez state and actions for the first adapter."""

    def __init__(self, bus):
        self.bus = bus
        self.discovering = None  # adapter path we started discovery on

    def state(self):
        objects = self.bus.objects(BLUEZ)
        adapter_path = next((p for p, ifaces in objects.items() if f"{BLUEZ}.Adapter1" in ifaces), None)
        if adapter_path is None:
            return None
        adapter = objects[adapter_path][f"{BLUEZ}.Adapter1"]
        info = {"adapter": adapter_path, "powered": bool(adapter.get("Powered")), "devices": []}
        for path, ifaces in objects.items():
            device = ifaces.get(f"{BLUEZ}.Device1")
            if not device or device.get("Adapter") != adapter_path:
                continue
            battery = ifaces.get(f"{BLUEZ}.Battery1", {}).get("Percentage")
            info["devices"].append({
                "path": path, "name": device.get("Alias") or device.get("Name") or device.get("Address", ""),
                "named": "Name" in device, "paired": bool(device.get("Paired") or device.get("Bonded")),
                "connected": bool(device.get("Connected")), "icon": device.get("Icon", ""),
                "rssi": device.get("RSSI"), "battery": battery,
            })
        return info

    def set_powered(self, adapter_path, on, done):
        self.bus.set_prop(BLUEZ, adapter_path, f"{BLUEZ}.Adapter1", "Powered", GLib.Variant("b", on), done)

    def start_discovery(self, adapter_path):
        if self.discovering:
            return
        self.discovering = adapter_path
        self.bus.call(BLUEZ, adapter_path, f"{BLUEZ}.Adapter1", "StartDiscovery")

    def stop_discovery(self):
        if self.discovering:
            self.bus.call(BLUEZ, self.discovering, f"{BLUEZ}.Adapter1", "StopDiscovery")
            self.discovering = None

    def toggle_connection(self, device, done):
        method = "Disconnect" if device["connected"] else "Connect"
        self.bus.call(BLUEZ, device["path"], f"{BLUEZ}.Device1", method, done=done)

    def pair_and_connect(self, device, done):
        def paired(error):
            if error:
                done(error)
                return
            self.bus.set_prop(BLUEZ, device["path"], f"{BLUEZ}.Device1", "Trusted", GLib.Variant("b", True))
            self.bus.call(BLUEZ, device["path"], f"{BLUEZ}.Device1", "Connect", done=done)

        self.bus.call(BLUEZ, device["path"], f"{BLUEZ}.Device1", "Pair", done=paired)


class Sound:
    """PipeWire outputs (sinks) and inputs (sources), through its PulseAudio interface with pactl."""

    def __init__(self):
        self.pending_volume = {}  # (kind, name) -> percent, sent in one go so a drag doesn't flood pactl

    @staticmethod
    def _glyph(kind, item):
        props = item.get("properties", {})
        form = props.get("device.form_factor", "")
        if form in ("headset", "headphone", "hands-free") or (kind == "sink" and props.get("device.bus") == "bluetooth"):
            return SOUND_ICONS["headphones"]
        if form == "webcam":
            return SOUND_ICONS["webcam"]
        if kind == "source":
            return SOUND_ICONS["mic"]
        if "hdmi" in (item.get("active_port") or "") or form in ("tv", "monitor"):
            return SOUND_ICONS["monitor"]
        return SOUND_ICONS["speaker"]

    def _devices(self, kind, default):
        try:
            items = json.loads(subprocess.run(["pactl", "-f", "json", "list", f"{kind}s"], capture_output=True,
                                              text=True, timeout=2).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return []
        devices = []
        for item in items:
            if item["name"].endswith(".monitor"):  # a sink's loopback, not a real input
                continue
            levels = [int(ch["value_percent"].rstrip("%")) for ch in item.get("volume", {}).values()]
            devices.append({
                "name": item["name"], "description": item.get("description") or item["name"],
                "muted": bool(item.get("mute")), "volume": round(sum(levels) / len(levels)) if levels else 0,
                "glyph": self._glyph(kind, item), "default": item["name"] == default,
            })
        return devices

    def state(self):
        return {"sink": self._devices("sink", first_line(["pactl", "get-default-sink"])),
                "source": self._devices("source", first_line(["pactl", "get-default-source"]))}

    @staticmethod
    def signature(info):
        """What the card's layout depends on; volume alone changes only the sliders."""
        return tuple((kind, d["name"], d["description"], d["muted"], d["default"])
                     for kind in ("sink", "source") for d in info[kind])

    @staticmethod
    def _pactl(*args):
        subprocess.Popen(["pactl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def set_volume(self, kind, name, percent):
        if not self.pending_volume:
            GLib.timeout_add(40, self._flush_volume)
        self.pending_volume[(kind, name)] = percent

    def _flush_volume(self):
        for (kind, name), percent in self.pending_volume.items():
            self._pactl(f"set-{kind}-volume", name, f"{percent}%")
        self.pending_volume.clear()
        return False

    def set_mute(self, kind, name, muted):
        self._pactl(f"set-{kind}-mute", name, "1" if muted else "0")

    def set_default(self, kind, name):
        self._pactl(f"set-default-{kind}", name)


def cli_json(command, timeout=3):
    """A command's JSON output, or None when it is missing, fails or prints none."""
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=timeout).stdout
        return json.loads(out) if out.strip() else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def parallel(**calls):
    """Run the (function, *args) calls at once; a call still running after CHECK_SECONDS gives
    its default instead: {name: result}. Each value is (default, function, *args)."""
    pool = ThreadPoolExecutor()
    futures = {name: pool.submit(*call[1:]) for name, call in calls.items()}
    deadline = time.monotonic() + CHECK_SECONDS
    results = {}
    for name, future in futures.items():
        try:
            results[name] = future.result(timeout=max(0, deadline - time.monotonic()))
        except TimeoutError:
            results[name] = calls[name][0]
    pool.shutdown(wait=False, cancel_futures=True)
    return results


def load_script(name):
    """One of the bar's Python status scripts in ~/.local/bin as a module, to reuse its checks."""
    sys.dont_write_bytecode = True  # no __pycache__ in ~/.local/bin
    path = os.path.join(BIN, name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class Vpn:
    """Tailscale and NetBird; switching goes through tailscale-status / netbird-status."""

    def state(self):
        return parallel(tailscale=(None, self._tailscale), netbird=(None, self._netbird))

    @staticmethod
    def _tailscale():
        data = cli_json(["tailscale", "status", "--json"])
        if data is None:
            return None
        backend = data.get("BackendState", "")
        state = {"Running": "connected", "Starting": "connecting",
                 "NeedsLogin": "login", "NeedsMachineAuth": "login"}.get(backend, "disconnected")
        ips = [ip for ip in data.get("TailscaleIPs") or [] if ":" not in ip]
        return {"state": state, "ip": ips[0] if ips else "",
                "network": (data.get("CurrentTailnet") or {}).get("Name", "")}

    @staticmethod
    def _netbird():
        data = cli_json(["netbird", "status", "--json"])
        if data is None:
            return None
        daemon = data.get("daemonStatus", "")
        state = {"Connected": "connected", "Connecting": "connecting", "NeedsLogin": "login",
                 "LoginFailed": "login", "SessionExpired": "login"}.get(daemon, "disconnected")
        try:
            listing = subprocess.run(["netbird", "profile", "list"], capture_output=True, text=True,
                                     timeout=2).stdout.splitlines()[1:]  # NAME / ACTIVE table
        except (OSError, subprocess.TimeoutExpired):
            listing = []
        return {"state": state, "ip": (data.get("netbirdIp") or "").split("/")[0],
                "network": data.get("fqdn", ""), "profile": data.get("profileName", ""),
                "profiles": [line.split()[0] for line in listing if line.split()]}

    @staticmethod
    def toggle(name):
        return [os.path.join(BIN, f"{name}-status"), "toggle"]

    @staticmethod
    def select_profile(profile):
        return [os.path.join(BIN, "netbird-status"), "select", profile]


class Dictation:
    """voxtype: the service, where speech is transcribed, LLM cleanup and the desk mic switch.

    Reuses voxtype-target's and voxtype-cleanup-status's own checks, so the card and the bar's
    icons always agree; switching goes through those scripts too.
    """

    def state(self):
        target = load_script("voxtype-target")
        cleanup = load_script("voxtype-cleanup-status")
        text = target.read()
        if text is None:
            return {}  # not set up
        settings = target.whisper_settings(text)
        endpoint = settings.get("remote_endpoint")
        config = cleanup.read_config()
        llm = config[1] if config else None
        llm_on = bool(llm) and not cleanup.OFF_SWITCH.exists()
        running = first_line(["systemctl", "--user", "is-active", "voxtype"]) == "active"

        checks = {"mic": (None, cli_json, [os.path.join(BIN, "desk-mic-status")], CHECK_SECONDS)}
        if endpoint:
            checks["server"] = ("it is unreachable (asleep?)", target.healthy, settings)
        if llm_on:
            checks["models"] = (None, cleanup.ollama_models, config[0])
        if running:
            checks["status"] = (None, cli_json, ["voxtype", "status", "--format", "json", "--extended"])
        found = parallel(**checks)

        llm_problem = None
        if llm_on:
            served = found["models"]
            if served is None:
                llm_problem = "the voxtype server is not reachable" if settings.get("mode") == "remote" \
                    else "the local Ollama is not reachable"
            elif llm not in served and f"{llm}:latest" not in served:
                llm_problem = f"{llm} is not pulled"
        return {
            "running": running, "status": found.get("status") or {},
            "model": settings.get("model", "?"), "remote": settings.get("mode") == "remote",
            "endpoint": endpoint, "server_problem": found.get("server"),
            "llm": llm, "llm_on": llm_on, "llm_problem": llm_problem,
            "mic": found["mic"] or {},
        }

    @staticmethod
    def switch_target(mode):
        return [os.path.join(BIN, "voxtype-target"), mode]

    @staticmethod
    def toggle_cleanup():
        return [os.path.join(BIN, "voxtype-cleanup-status"), "toggle"]

    @staticmethod
    def service(action):
        return ["systemctl", "--user", action, "voxtype"]


class System:
    """CPU and memory use from /proc, the auto-sleep daemon (hypridle) and the power actions."""

    def __init__(self):
        self.last_cpu = None  # (busy, total) jiffies at the previous reading

    def state(self):
        """What the card's layout depends on; the figures update in place (usage())."""
        return {"sleep": subprocess.run(["pgrep", "-x", "hypridle"], capture_output=True).returncode == 0}

    def _cpu_times(self):
        with open("/proc/stat") as f:
            fields = [int(x) for x in f.readline().split()[1:]]
        idle = fields[3] + fields[4]  # idle + iowait
        return sum(fields) - idle, sum(fields)

    @staticmethod
    def _temperature():
        for hwmon in os.listdir("/sys/class/hwmon"):
            base = os.path.join("/sys/class/hwmon", hwmon)
            try:
                with open(os.path.join(base, "name")) as f:
                    if f.read().strip() not in ("k10temp", "coretemp", "zenpower"):
                        continue
                with open(os.path.join(base, "temp1_input")) as f:
                    return int(f.read()) / 1000
            except (OSError, ValueError):
                continue
        return None

    def usage(self):
        busy, total = self._cpu_times()
        if self.last_cpu is None:  # first reading: measure over a short moment
            self.last_cpu = (busy, total)
            time.sleep(0.15)
            busy, total = self._cpu_times()
        last_busy, last_total = self.last_cpu
        self.last_cpu = (busy, total)
        cpu = (busy - last_busy) / (total - last_total) if total > last_total else 0.0

        mem = {}
        with open("/proc/meminfo") as f:
            for line in f:
                key, value = line.split(":")
                mem[key] = int(value.split()[0]) * 1024
        with open("/proc/loadavg") as f:
            load = f.read().split()[0]
        used = mem["MemTotal"] - mem["MemAvailable"]
        return {"cpu": cpu, "load": load, "cores": os.cpu_count(), "temp": self._temperature(),
                "mem_used": used, "mem_total": mem["MemTotal"],
                "swap_used": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)}

    @staticmethod
    def toggle_sleep():
        return [os.path.join(BIN, "sleep-toggle"), "toggle"]


def gib(size):
    return f"{size / 2**30:.1f} GB"


class Popover(Gtk.Application):
    def __init__(self, view):
        super().__init__(application_id=APP_ID)
        self.view = view
        self.window = None
        self.busy = set()  # paths with a connect/pair/disconnect in flight
        self.errors = {}  # path -> message shown under the row for a few seconds
        self.expanded = None  # Wi-Fi network path whose password box is open
        self.details_open = False
        self.other_open = True
        self.password = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
        self.password.connect("activate", lambda _e: self._join_expanded())
        self.refresh_pending = False
        self.sound_signature = None
        self.sliders = {}  # "sink"/"source" -> (scale, percent label) of the default device
        self.updating_sliders = False
        self.volume_set_at = 0.0  # last time a slider was moved here; pactl's echo of it is ignored
        self.slow = {}  # SLOW_VIEWS view -> last fetched state
        self.fetching = set()
        self.poll_id = None
        self.wanted = {}  # busy key -> the on/off its switch was flipped to, shown until confirmed
        self.action_done_at = 0.0  # a fetch started before this carries state from before the action
        toggle = Gio.SimpleAction.new("toggle", GLib.VariantType.new("s"))
        toggle.connect("activate", lambda _a, param: self.toggle(param.unpack()))
        self.add_action(toggle)

    # lifecycle

    def do_activate(self):
        if self.window is not None:
            return
        self.hold()
        self.bus = Bus()
        self.wifi = Wifi(self.bus)
        self.bt = Bluetooth(self.bus)
        self.sound = Sound()
        self.vpn = Vpn()
        self.dictation = Dictation()
        self.system = System()
        self.sources = {"vpn": self.vpn, "dictation": self.dictation, "system": self.system}
        self.usage_widgets = None  # the System card's figures, updated in place
        self.usage_id = None
        self.confirming = None  # power action waiting for its second click
        self.bus.watch(IWD, self.schedule_refresh)
        self.bus.watch(BLUEZ, self.schedule_refresh)
        self._watch_sound()

        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER)

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.add_css_class("net-popover")
        LayerShell.init_for_window(self.window)
        LayerShell.set_namespace(self.window, "net-popover")
        LayerShell.set_layer(self.window, LayerShell.Layer.TOP)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self.window, edge, True)
        LayerShell.set_keyboard_mode(self.window, LayerShell.KeyboardMode.EXCLUSIVE)

        self.card = vbox(0)
        self.card.add_css_class("card")
        self.card.set_size_request(CARD_WIDTH, -1)
        self.card.set_halign(Gtk.Align.END)
        self.card.set_valign(Gtk.Align.START)
        self.card.set_margin_top(6)
        self.window.set_child(self.card)

        click = Gtk.GestureClick(button=0)
        click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        click.connect("pressed", self._on_backdrop_click)
        self.window.add_controller(click)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._on_key)
        self.window.add_controller(keys)

        self.show(self.view)

    def toggle(self, view):
        if view not in VIEWS:
            return
        if self.window.get_visible() and self.view == view:
            self.hide()
        else:
            self.show(view)

    def show(self, view):
        if self.view != view:
            self.expanded = None
            self.details_open = False
        self.view = view
        self._place_under_cursor()
        self.rebuild(rescan=True)
        self.window.present()
        if view == "system" and self.usage_id is None:
            self.usage_id = GLib.timeout_add_seconds(USAGE_SECONDS, self._tick_usage)
        if view in SLOW_VIEWS:
            self.fetch(view)
            if self.poll_id is None:
                self.poll_id = GLib.timeout_add_seconds(POLL_SECONDS, self._poll)

    def hide(self):
        self.confirming = None
        self.bt.stop_discovery()
        self.expanded = None
        self.details_open = False
        self.password.set_text("")
        self.window.set_visible(False)

    def _on_backdrop_click(self, gesture, _n, x, y):
        ok, bounds = self.card.compute_bounds(self.window)
        if not ok or not bounds.contains_point(Graphene.Point().init(x, y)):
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.hide()

    def _on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.expanded:
                self.expanded = None
                self.rebuild()
            else:
                self.hide()
            return True
        return False

    def _place_under_cursor(self):
        """Put the card on the cursor's monitor, centred under the clicked bar icon."""
        try:
            cursor = json.loads(subprocess.run(["hyprctl", "cursorpos", "-j"], capture_output=True,
                                               text=True, timeout=1).stdout)
            monitors = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                                 text=True, timeout=1).stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return
        for mon in monitors:
            width = mon["width"] / mon["scale"]
            height = mon["height"] / mon["scale"]
            if mon["transform"] % 2:
                width, height = height, width
            if mon["x"] <= cursor["x"] < mon["x"] + width and mon["y"] <= cursor["y"] < mon["y"] + height:
                right = mon["x"] + width - cursor["x"] - CARD_WIDTH / 2
                self.card.set_margin_end(int(max(EDGE_GAP, right)))
                for gdk_mon in Gdk.Display.get_default().get_monitors():
                    if gdk_mon.get_connector() == mon["name"]:
                        LayerShell.set_monitor(self.window, gdk_mon)
                return

    # state changes

    def schedule_refresh(self):
        if self.refresh_pending or not self.window or not self.window.get_visible():
            return
        self.refresh_pending = True

        def run():
            self.refresh_pending = False
            # the slow views poll instead
            if self.window.get_visible() and self.view not in SLOW_VIEWS:
                self._refresh_sound() if self.view == "sound" else self.rebuild()
            return False

        GLib.timeout_add(150, run)

    def fetch(self, view):
        """Fetch a slow view's state in a thread; the card rebuilds when it arrives and changed."""
        if view in self.fetching:
            return
        self.fetching.add(view)
        source = self.sources[view]

        started = time.monotonic()

        def work():
            GLib.idle_add(arrived, self._read_state(source))

        def arrived(result):
            self.fetching.discard(view)
            if started < self.action_done_at:
                return False  # from before an action: the action brought its own fresh state
            changed = self.slow.get(view, ...) != result
            self.slow[view] = result
            if changed and self.window.get_visible() and self.view == view:
                self.rebuild()
            return False

        threading.Thread(target=work, daemon=True).start()

    def _poll(self):
        if not self.window.get_visible() or self.view not in SLOW_VIEWS:
            self.poll_id = None
            return False
        self.fetch(self.view)
        return True

    @staticmethod
    def _read_state(source):
        try:
            return source.state()
        except Exception as err:  # noqa: BLE001 - a broken script must not kill the panel
            return {"error": str(err) or type(err).__name__}

    def run_command(self, key, command, want=None):
        """run_action for a command that may block (pkexec, service restarts): run it in a thread.

        The row stays busy (spinner, its switch held at `want`) until the command has run and the
        view's state has been read again, so the switch never flips back to the old state meanwhile.
        """
        view = self.view
        source = self.sources[view]
        if want is not None:
            self.wanted[key] = want

        def start(done):
            def work():
                try:
                    proc = subprocess.run(command, capture_output=True, text=True, timeout=120)
                    output = (proc.stderr or proc.stdout).strip().splitlines()
                    error = None if proc.returncode == 0 else (output[-1] if output else "Failed")
                except (OSError, subprocess.TimeoutExpired):
                    error = "Failed"
                GLib.idle_add(finished, error, self._read_state(source))

            def finished(error, state):
                self.wanted.pop(key, None)
                self.slow[view] = state
                self.action_done_at = time.monotonic()
                done(error)
                return False

            threading.Thread(target=work, daemon=True).start()

        self.run_action(key, start)

    def shown(self, key, actual):
        """A switch's position: where it was flipped to while that change runs, else the real state."""
        return self.wanted.get(key, actual) if key in self.busy else actual

    def _watch_sound(self):
        """Refresh the Sound card on PipeWire device, volume and default changes (pactl subscribe)."""
        try:
            proc = Gio.Subprocess.new(["pactl", "subscribe"], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error:
            return
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def on_line(source, result):
            try:
                line, _length = source.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                # pactl exits when the audio server restarts: subscribe again once it is back
                GLib.timeout_add_seconds(2, lambda: (self._watch_sound(), False)[1])
                return
            words = line.split()  # Event 'change' on sink #65
            if self.view == "sound" and len(words) > 3 and words[3] in ("sink", "source", "server", "card"):
                self.schedule_refresh()
            source.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def run_action(self, path, start):
        """Mark path busy, start the action, then show its error (if any) under the row."""
        self.busy.add(path)
        self.errors.pop(path, None)

        def done(error):
            self.busy.discard(path)
            if error:
                self.errors[path] = error
                GLib.timeout_add_seconds(ERROR_SECONDS, self._clear_error, path, error)
            self.rebuild()

        start(done)
        self.rebuild()

    def _clear_error(self, path, error):
        if self.errors.get(path) == error:
            del self.errors[path]
            self.rebuild()
        return False

    # building the card

    def rebuild(self, rescan=False):
        if self.password.get_parent():
            self.password.get_parent().remove(self.password)
        while child := self.card.get_first_child():
            self.card.remove(child)
        self.sliders = {}
        if self.view == "wifi":
            self._build_wifi(rescan)
        elif self.view == "bluetooth":
            self._build_bluetooth(rescan)
        elif self.view == "sound":
            self._build_sound()
        elif self.view == "vpn":
            self._build_vpn()
        elif self.view == "dictation":
            self._build_dictation()
        else:
            self._build_system()

    def _header(self, title, active=False, on_toggle=None, busy=False):
        box = hbox(10, label(title, "title", hexpand=True))
        if busy:
            box.append(spinner())
        if on_toggle:
            switch = unfocusable(Gtk.Switch(active=active, valign=Gtk.Align.CENTER, sensitive=not busy))
            switch.connect("state-set", lambda _s, on: (on_toggle(on), False)[1])
            box.append(switch)
        else:
            box.set_size_request(-1, 36)  # same height as the headers with a switch
        box.set_margin_start(10)
        box.set_margin_end(8)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        self.card.append(box)

    def _footer(self, items):
        self.card.append(Gtk.Separator())
        for text, hint, action in items:
            content = hbox(10, label(text, hexpand=True))
            if hint:
                content.append(label(hint, "mono"))
            button = unfocusable(Gtk.Button(child=content))
            button.add_css_class("menu")
            button.connect("clicked", lambda _b, act=action: (self.hide(), act()))
            self.card.append(button)

    def _empty(self, text):
        self.card.append(label(text, "empty"))

    def _scrolled(self, box, max_height=520):
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                      max_content_height=max_height)
        scroller.set_child(box)
        self.card.append(scroller)

    # Wi-Fi

    def _build_wifi(self, rescan):
        info = self.wifi.state()
        footer = [("Network Settings…", "impala", lambda: run_tui("impala")),
                  ("Restart Network", "right-click", lambda: subprocess.Popen(
                      [os.path.join(BIN, "network-restart-menu")], start_new_session=True))]
        if info is None:
            self._header("Wi-Fi", False, lambda _on: None)
            self._empty("No Wi-Fi adapter found.")
            self._footer(footer)
            return
        self._header("Wi-Fi", info["powered"], lambda on: self.run_action(
            info["device"], lambda done: self.wifi.set_powered(info, on, done)))
        if not info["powered"]:
            self._empty("Wi-Fi is off.")
            self._footer(footer)
            return
        if rescan and not info["scanning"]:
            self.wifi.scan(info["device"])

        body = vbox(0)
        known = [n for n in info["networks"] if n["known"]]
        known.sort(key=lambda n: not n["connected"])
        other = [n for n in info["networks"] if not n["known"] and n["name"]]

        body.append(Gtk.Separator())
        if known:
            body.append(section("Known Networks"))
            for net in known:
                self._wifi_row(body, info, net)

        fold_label = hbox(6, label("Other Networks", "section", hexpand=True))
        if info["scanning"]:
            fold_label.append(spinner())
        fold_label.append(label("\U000f0142" if not self.other_open else "\U000f0140", "glyph", "dim"))
        fold = unfocusable(Gtk.Button(child=fold_label))
        fold.add_css_class("fold")
        fold.set_margin_top(4)
        fold.connect("clicked", lambda _b: self._toggle_other())
        body.append(fold)
        if self.other_open:
            for net in other:
                self._wifi_row(body, info, net)
            if not other:
                body.append(label("Searching…" if info["scanning"] else "No other networks nearby.", "sub", "empty"))
        self._scrolled(body)
        self._footer(footer)

    def _toggle_other(self):
        self.other_open = not self.other_open
        self.rebuild()

    def _wifi_row(self, body, info, net):
        path = net["path"]
        current = net["connected"]
        busy = path in self.busy or (current and info["state"] in ("connecting", "roaming"))
        secured = net["type"] != "open"
        if path in self.errors:
            subtitle, error = self.errors[path], True
        elif busy:
            subtitle, error = "Connecting…", False
        elif current:
            mhz = self.wifi.diagnostics(info["device"]).get("Frequency")
            subtitle, error = " · ".join(x for x in ("Connected", band(mhz)) if x), False
        else:
            subtitle, error = None, False

        children = [icon(wifi_bars(net["dbm"]), active=current), title_block(net["name"], subtitle, error)]
        if busy:
            children.append(spinner())
        if secured:
            children.append(label(LOCK, "glyph", "dim"))
        body.append(row(children, lambda: self._wifi_clicked(info, net)))

        if current and self.details_open:
            body.append(self._wifi_details(info, net))
        if self.expanded == path:
            join = pill("Join", self._join_expanded, accent=True)
            box = hbox(6, self.password, join)
            box.set_margin_start(46)
            box.set_margin_end(8)
            box.set_margin_bottom(8)
            box.set_margin_top(2)
            body.append(box)
            GLib.idle_add(self.password.grab_focus)

    def _wifi_clicked(self, info, net):
        if net["connected"]:
            self.details_open = not self.details_open
            self.rebuild()
        elif net["known"] or net["type"] == "open":
            self._wifi_connect(net["path"], None, secured=net["type"] != "open")
        elif net["type"] == "psk":
            self.expanded = None if self.expanded == net["path"] else net["path"]
            self.password.set_text("")
            self.rebuild()
        else:
            # enterprise (802.1x) networks need a provisioning file: leave them to impala/iwctl
            self.errors[net["path"]] = "Enterprise network: set it up in impala"
            GLib.timeout_add_seconds(ERROR_SECONDS, self._clear_error, net["path"], self.errors[net["path"]])
            self.rebuild()

    def _join_expanded(self):
        if self.expanded:
            path, passphrase = self.expanded, self.password.get_text()
            self.expanded = None
            self.password.set_text("")
            self._wifi_connect(path, passphrase)

    def _wifi_connect(self, path, passphrase, secured=True):
        self.details_open = False

        def start(done):
            def finished(error):
                if error and secured:
                    # usually a wrong or changed password: open the box so it can be retyped
                    self.expanded = path
                    error = "Couldn't connect, check the password"
                done(error)

            self.wifi.connect(path, passphrase, finished)

        self.run_action(path, start)

    def _wifi_details(self, info, net):
        address, router = ip_details(info["ifname"])
        diag = self.wifi.diagnostics(info["device"])
        rssi = diag.get("RSSI", net["dbm"])
        grid = Gtk.Grid(column_spacing=12, row_spacing=4)
        grid.add_css_class("details")
        rows = [("IP address", address or "—"), ("Router", router or "—"), ("Signal", f"{rssi:.0f} dBm")]
        for i, (name, value) in enumerate(rows):
            grid.attach(label(name, "dim"), 0, i, 1, 1)
            value_label = label(value)
            value_label.set_selectable(True)
            grid.attach(value_label, 1, i, 1, 1)
        buttons = hbox(6, pill("Disconnect", lambda: self.run_action(
            net["path"], lambda done: self.wifi.disconnect(info["device"], done))))
        if net["known"]:
            buttons.append(pill("Forget", lambda: self.run_action(
                net["path"], lambda done: self.wifi.forget(net["known"], done))))
        buttons.set_margin_top(4)
        grid.attach(buttons, 1, len(rows), 1, 1)
        grid.set_margin_start(46)
        grid.set_margin_end(8)
        grid.set_margin_bottom(8)
        grid.set_margin_top(2)
        return grid

    # Bluetooth

    def _build_bluetooth(self, rescan):
        info = self.bt.state()
        footer = [("Bluetooth Settings…", "bluetui", lambda: run_tui("bluetui"))]
        if info is None:
            self._header("Bluetooth", False, lambda _on: None)
            self._empty("No Bluetooth adapter found.")
            self._footer(footer)
            return
        self._header("Bluetooth", info["powered"], lambda on: self.run_action(
            info["adapter"], lambda done: self.bt.set_powered(info["adapter"], on, done)))
        if not info["powered"]:
            self.bt.discovering = None
            self._empty("Bluetooth is off.")
            self._footer(footer)
            return
        if rescan:
            self.bt.start_discovery(info["adapter"])

        body = vbox(0)
        body.append(Gtk.Separator())
        mine = sorted((d for d in info["devices"] if d["paired"]), key=lambda d: (not d["connected"], d["name"].lower()))
        nearby = [d for d in info["devices"] if not d["paired"] and d["named"]]
        nearby.sort(key=lambda d: -(d["rssi"] if d["rssi"] is not None else -999))

        if mine:
            body.append(section("My Devices"))
            for device in mine:
                body.append(self._bt_device_row(device))
        body.append(section("Nearby Devices", hbox(5, spinner(), label("Searching", "sub"))))
        for device in nearby[:8]:
            body.append(self._bt_nearby_row(device))
        if not nearby:
            body.append(label("Put a device in pairing mode to see it here.", "sub", "empty"))
        self._scrolled(body)
        self._footer(footer)

    def _bt_device_row(self, device):
        path = device["path"]
        busy = path in self.busy
        if path in self.errors:
            subtitle, error = self.errors[path], True
        elif busy:
            subtitle, error = ("Disconnecting…" if device["connected"] else "Connecting…"), False
        else:
            subtitle, error = ("Connected" if device["connected"] else "Not connected"), False
        children = [icon(BT_ICONS.get(device["icon"], BT_DEFAULT), active=device["connected"]),
                    title_block(device["name"], subtitle, error)]
        if busy:
            children.append(spinner())
        elif device["connected"] and device["battery"] is not None:
            level = BATTERY[min(9, max(0, (device["battery"] - 1) // 10))]
            children.append(label(f"{device['battery']}% {level}", "mono"))
        return row(children, lambda: self.run_action(path, lambda done: self.bt.toggle_connection(device, done)),
                   tooltip="Click to connect or disconnect")

    def _bt_nearby_row(self, device):
        path = device["path"]
        children = [icon(BT_ICONS.get(device["icon"], BT_DEFAULT)),
                    title_block(device["name"], self.errors.get(path), path in self.errors)]
        if path in self.busy:
            children.append(hbox(6, spinner(), label("Pairing", "sub")))
        else:
            children.append(pill("Connect", lambda: self.run_action(
                path, lambda done: self.bt.pair_and_connect(device, done))))
        box = hbox(10, *children)
        box.set_margin_start(8)
        box.set_margin_end(8)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        return box

    def _slow_state(self, title):
        """The fetched state of the current slow view, or None after showing a placeholder card."""
        info = self.slow.get(self.view, ...)
        if info is ... or (isinstance(info, dict) and "error" in info):
            self._header(title)
            if info is ...:
                loading = hbox(8, spinner(), label("Loading…", "dim"))
                loading.set_margin_start(10)
                loading.set_margin_top(10)
                loading.set_margin_bottom(14)
                self.card.append(loading)
            else:
                self._empty(f"Couldn't read the state: {info['error']}")
            return None
        return info

    def _switch_row(self, glyph, title, subtitle, active, on_toggle, error=False, sensitive=True, busy=False):
        children = [icon(glyph, active=active), title_block(title, subtitle, error)]
        if busy:
            children.append(spinner())
        switch = unfocusable(Gtk.Switch(active=active, valign=Gtk.Align.CENTER, sensitive=sensitive and not busy))
        switch.connect("state-set", lambda _s, on: (on_toggle(on), False)[1])
        children.append(switch)
        box = hbox(10, *children)
        box.set_margin_start(8)
        box.set_margin_end(8)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        return box

    def _info_row(self, glyph, title, subtitle=None, active=False, error=False):
        box = hbox(10, icon(glyph, active=active), title_block(title, subtitle, error))
        box.set_margin_start(8)
        box.set_margin_end(8)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        return box

    # System

    def _build_system(self):
        self.usage_widgets = None
        info = self._slow_state("System")
        if info is None:
            return
        self._header("System")
        body = vbox(0)
        body.append(Gtk.Separator())

        body.append(section("Usage"))
        self.usage_widgets = {"cpu": self._usage_row(body, CPU, "CPU"),
                              "mem": self._usage_row(body, MEMORY, "Memory")}
        self._fill_usage()

        body.append(section("Sleep"))
        # on = hypridle stopped: the switch reads as "keep awake", the exception, not "auto-sleep"
        awake = self.shown("awake", not info["sleep"])
        if "awake" in self.busy:
            sub = "Turning on…" if awake else "Turning off…"
        else:
            sub = "Never locks or sleeps when idle" if awake else "Off: locks and sleeps when idle"
        body.append(self._switch_row(SLEEP_OFF if awake else SLEEP_ON, "Keep awake", sub, awake,
                                     lambda want: self.run_command("awake", System.toggle_sleep(), want=want),
                                     busy="awake" in self.busy))

        body.append(section("Power"))
        for key, glyph, title, command, confirm in POWER_ACTIONS:
            asking = self.confirming == key
            body.append(row([icon(glyph, active=asking),
                             title_block(title, f"Click again to {title.lower()}" if asking else None, asking)],
                            lambda k=key, c=command, ask=confirm: self._power(k, c, ask)))
        self._scrolled(body, max_height=760)  # fixed content: show all of it
        self._footer([("Applications…", "tofi", lambda: subprocess.Popen(
                          ["sh", "-c", "tofi-drun | ifne xargs uwsm app --"], start_new_session=True)),
                      ("Activity Monitor…", "btop", lambda: run_tui("btop")),
                      ("Power Menu…", None, lambda: subprocess.Popen(
                          [os.path.join(BIN, "powermenu")], start_new_session=True))])

    def _usage_row(self, body, glyph, title):
        figure = label("", "figure", xalign=1.0)
        bar = Gtk.LevelBar(min_value=0, max_value=1, hexpand=True)
        bar.set_size_request(-1, 6)
        for offset in ("low", "high", "full"):
            bar.remove_offset_value(offset)
        detail = label("", "sub")
        text = vbox(4, hbox(8, label(title, hexpand=True), figure), bar, detail)
        text.set_hexpand(True)
        box = hbox(10, icon(glyph), text)
        box.set_margin_start(8)
        box.set_margin_end(10)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        body.append(box)
        return figure, bar, detail

    def _fill_usage(self):
        if not self.usage_widgets:
            return
        try:
            use = self.system.usage()
        except (OSError, ValueError, KeyError):
            return
        figure, bar, detail = self.usage_widgets["cpu"]
        figure.set_text(f"{use['cpu']:.0%}")
        bar.set_value(use["cpu"])
        (bar.add_css_class if use["cpu"] >= 0.85 else bar.remove_css_class)("busy")
        temp = f" · {use['temp']:.0f}°C" if use["temp"] is not None else ""
        detail.set_text(f"Load {use['load']} on {use['cores']} cores{temp}")

        figure, bar, detail = self.usage_widgets["mem"]
        share = use["mem_used"] / use["mem_total"]
        figure.set_text(f"{share:.0%}")
        bar.set_value(share)
        (bar.add_css_class if share >= 0.85 else bar.remove_css_class)("busy")
        swap = f" · swap {gib(use['swap_used'])}" if use["swap_used"] > 2**26 else ""
        detail.set_text(f"{gib(use['mem_used'])} of {gib(use['mem_total'])} used{swap}")

    def _tick_usage(self):
        if not self.window.get_visible() or self.view != "system":
            self.usage_id = None
            return False
        self._fill_usage()
        return True

    def _power(self, key, command, confirm):
        if confirm and self.confirming != key:
            self.confirming = key
            GLib.timeout_add_seconds(CONFIRM_SECONDS, self._end_confirm, key)
            self.rebuild()
            return
        self.hide()
        subprocess.Popen(command, start_new_session=True)

    def _end_confirm(self, key):
        if self.confirming == key:
            self.confirming = None
            if self.window.get_visible() and self.view == "system":
                self.rebuild()
        return False

    # VPN

    def _build_vpn(self):
        info = self._slow_state("VPN")
        if info is None:
            return
        self._header("VPN")
        body = vbox(0)
        body.append(Gtk.Separator())
        found = False
        for key, name, glyph in (("tailscale", "Tailscale", TAILSCALE), ("netbird", "NetBird", NETBIRD)):
            vpn = info.get(key)
            if vpn is None:
                continue
            found = True
            body.append(self._vpn_row(key, name, glyph, vpn))
            if key == "netbird" and vpn["profiles"]:  # shown even with one, to see which is active
                body.append(section("NetBird Profile"))
                for profile in vpn["profiles"]:
                    current = profile == vpn["profile"]
                    busy = f"profile:{profile}" in self.busy
                    children = [icon(ACCOUNT, active=current), title_block(profile, self.errors.get(f"profile:{profile}"),
                                                                          f"profile:{profile}" in self.errors)]
                    if busy:
                        children.append(spinner())
                    elif current:
                        children.append(label(CHECK, "glyph"))
                    body.append(row(children, lambda p=profile, cur=current: None if cur else self.run_command(
                        f"profile:{p}", Vpn.select_profile(p))))
        if not found:
            body.append(label("Neither Tailscale nor NetBird is installed.", "empty"))
        self._scrolled(body)

    def _vpn_row(self, key, name, glyph, vpn):
        busy = key in self.busy
        connected = vpn["state"] == "connected"
        if key in self.errors:
            subtitle, error = self.errors[key], True
        elif busy:
            subtitle, error = "Connecting…" if self.shown(key, not connected) else "Disconnecting…", False
        elif vpn["state"] == "connecting":
            subtitle, error = "Connecting…", False
        elif connected:
            subtitle, error = " · ".join(x for x in (vpn["ip"], vpn["network"]) if x) or "Connected", False
        elif vpn["state"] == "login":
            subtitle, error = "Needs login: turn on to sign in", False
        else:
            subtitle, error = "Off", False
        return self._switch_row(glyph, name, subtitle, self.shown(key, connected),
                                lambda on: self.run_command(key, Vpn.toggle(key), want=on), error, busy=busy)

    # Dictation

    def _build_dictation(self):
        info = self._slow_state("Dictation")
        if info is None:
            return
        if not info:
            self._header("Dictation")
            self._empty("Voxtype is not set up.")
            return
        self._header("Dictation", self.shown("service", info["running"]), lambda on: self.run_command(
            "service", Dictation.service("start" if on else "stop"), want=on), busy="service" in self.busy)
        body = vbox(0)
        body.append(Gtk.Separator())

        status = info["status"]
        state = status.get("class") or status.get("alt") or ""
        if "service" in self.busy:
            title = "Starting…" if self.shown("service", not info["running"]) else "Stopping…"
        elif not info["running"]:
            title = "Off"
        else:
            title = {"recording": "Recording…", "transcribing": "Transcribing…"}.get(state, "Ready: hold the hotkey to dictate")
        detail = " · ".join(x for x in (status.get("model"), status.get("backend")) if x)
        body.append(self._info_row(DICTATION, title, detail or None, active=state == "recording"))

        body.append(section("Transcribe On"))
        body.append(self._target_row("local", LOCAL, "This computer", info["model"], not info["remote"]))
        if not info["endpoint"]:
            server_sub, server_error = "Not set up (voxtype_server_url)", False
        elif info["server_problem"]:
            server_sub, server_error = f"Server: {info['server_problem']}", True
        else:
            server_sub, server_error = urlparse(info["endpoint"]).netloc or info["endpoint"], False
        body.append(self._target_row("remote", SERVER, "Voxtype server", server_sub, info["remote"],
                                     error=server_error, enabled=bool(info["endpoint"])))

        body.append(section("Cleanup"))
        if not info["llm"]:
            sub, error = "No LLM set up (arch_voxtype_llm_enabled)", False
        elif "cleanup" in self.errors:
            sub, error = self.errors["cleanup"], True
        elif "cleanup" in self.busy:
            sub, error = "Turning on…" if self.shown("cleanup", not info["llm_on"]) else "Turning off…", False
        elif info["llm_problem"]:
            sub, error = f"{info['llm_problem']}: typing raw transcripts", True
        else:
            sub, error = f"{info['llm']} on {'the voxtype server' if info['remote'] else 'this computer'}", False
        body.append(self._switch_row(CLEANUP, "LLM cleanup", sub, self.shown("cleanup", info["llm_on"]),
                                     lambda on: self.run_command("cleanup", Dictation.toggle_cleanup(), want=on),
                                     error, sensitive=bool(info["llm"]), busy="cleanup" in self.busy))

        mic = info["mic"]
        if mic.get("text"):
            body.append(section("Desk Mic"))
            title = {"live": "Switch is on: the room can be heard", "off": "Switch is off"}.get(
                mic.get("class"), "Couldn't read the level")
            body.append(self._info_row(mic["text"], title, None, active=mic.get("class") == "live",
                                       error=mic.get("class") == "unknown"))
        self._scrolled(body)
        self._footer([("Restart Voxtype", None, lambda: subprocess.Popen(
            Dictation.service("restart"), start_new_session=True))])

    def _target_row(self, mode, glyph, title, subtitle, current, error=False, enabled=True):
        key = f"target:{mode}"
        busy = key in self.busy
        if key in self.errors:
            subtitle, error = self.errors[key], True
        children = [icon(glyph, active=current), title_block(title, "Switching…" if busy else subtitle, error)]
        if busy:
            children.append(spinner())
        elif current:
            children.append(label(CHECK, "glyph"))
        button = row(children, lambda: None if current or not enabled else self.run_command(
            key, Dictation.switch_target(mode)))
        button.set_sensitive(enabled or current)
        return button

    # Sound

    def _build_sound(self, info=None):
        info = info or self.sound.state()
        self.sound_signature = Sound.signature(info)
        self._header("Sound")
        body = vbox(0)
        body.append(Gtk.Separator())
        for kind, title in (("sink", "Output"), ("source", "Input")):
            body.append(section(title))
            devices = info[kind]
            current = next((d for d in devices if d["default"]), None)
            if current:
                body.append(self._volume_row(kind, current))
            for device in devices:
                body.append(self._sound_device_row(kind, device))
            if not devices:
                body.append(label(f"No {title.lower()} devices.", "sub", "empty"))
        self._scrolled(body)
        self._footer([("Sound Settings…", "wiremix", lambda: run_tui("wiremix")),
                      ("Restart Audio", "right-click", lambda: subprocess.Popen(
                          ["systemctl", "--user", "restart", "wireplumber"], start_new_session=True))])

    def _refresh_sound(self):
        """Rebuild when devices, defaults or mutes changed; otherwise only move the sliders."""
        info = self.sound.state()
        if Sound.signature(info) != self.sound_signature or not self.sliders:
            self.rebuild()
            return
        if time.monotonic() - self.volume_set_at < 1:
            return  # our own drag is still echoing back
        self.updating_sliders = True
        for kind, (scale, percent) in self.sliders.items():
            current = next((d for d in info[kind] if d["default"]), None)
            if current:
                scale.set_value(min(100, current["volume"]))
                percent.set_text(f"{current['volume']}%")
        self.updating_sliders = False

    def _volume_row(self, kind, device):
        on, off = (VOLUME_ON, VOLUME_OFF) if kind == "sink" else (MIC_ON, MIC_OFF)
        mute = unfocusable(Gtk.Button(child=icon(off if device["muted"] else on, active=not device["muted"]),
                                      valign=Gtk.Align.CENTER))
        mute.add_css_class("bare")
        mute.set_tooltip_text("Unmute" if device["muted"] else "Mute")
        mute.connect("clicked", lambda _b: self.sound.set_mute(kind, device["name"], not device["muted"]))

        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        unfocusable(scale)
        scale.set_draw_value(False)
        scale.set_hexpand(True)
        scale.set_value(min(100, device["volume"]))
        percent = label(f"{device['volume']}%", "mono", xalign=1.0)
        percent.set_size_request(36, -1)

        def changed(_scale):
            if self.updating_sliders:
                return
            value = int(scale.get_value())
            percent.set_text(f"{value}%")
            self.volume_set_at = time.monotonic()
            self.sound.set_volume(kind, device["name"], value)

        scale.connect("value-changed", changed)
        self.sliders[kind] = (scale, percent)
        box = hbox(8, mute, scale, percent)
        box.set_margin_start(8)
        box.set_margin_end(10)
        box.set_margin_top(2)
        box.set_margin_bottom(4)
        return box

    def _sound_device_row(self, kind, device):
        children = [icon(device["glyph"], active=device["default"]),
                    title_block(device["description"], "Muted" if device["muted"] else None)]
        if device["default"]:
            children.append(label(CHECK, "glyph"))
        return row(children, lambda: self.sound.set_default(kind, device["name"]))


if __name__ == "__main__":
    Popover(VIEW).run([sys.argv[0]])
