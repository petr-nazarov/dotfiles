#!/usr/bin/python3
"""Waybar's Wi-Fi and Bluetooth panels: a macOS-style card under the bar icon.

`net-popover wifi` / `net-popover bluetooth` shows that panel, or hides it when it is already
showing. The first call starts a resident GTK app; later calls only send it a D-Bus message, so
a click opens the card at once. Wi-Fi talks to iwd and Bluetooth to bluez over the system bus;
impala and bluetui stay one click away in each panel's footer.

The card sits on a transparent layer that covers the screen below the bar, so a click anywhere
outside it (or Escape) closes it, and clicking the bar icon again toggles it.
"""

import ctypes
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

APP_ID = "dev.nazarov.NetPopover"
APP_PATH = "/dev/nazarov/NetPopover"
VIEWS = ("wifi", "bluetooth")


def forward_to_running(view):
    """Toggle the panel in an already running instance; False when none is running."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync(
            APP_ID,
            APP_PATH,
            "org.freedesktop.Application",
            "ActivateAction",
            GLib.Variant("(sava{sv})", ("toggle", [GLib.Variant("s", view)], {})),
            None,
            Gio.DBusCallFlags.NO_AUTO_START,
            1000,
            None,
        )
        return True
    except GLib.Error:
        return False


if __name__ == "__main__":
    VIEW = sys.argv[1] if len(sys.argv) > 1 else "wifi"
    if VIEW not in VIEWS:
        sys.exit(f"usage: net-popover {{{'|'.join(VIEWS)}}}")
    if forward_to_running(VIEW):
        sys.exit(0)

# gtk4-layer-shell has to be loaded before libwayland-client, which GTK pulls in
ctypes.CDLL("libgtk4-layer-shell.so", mode=ctypes.RTLD_GLOBAL)
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Graphene", "1.0")
from gi.repository import Gdk, Graphene, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

BIN = os.path.expanduser("~/.local/bin")
CARD_WIDTH = 320
EDGE_GAP = 8  # the card never comes closer than this to the screen's right edge
ERROR_SECONDS = 5

IWD = "net.connman.iwd"
BLUEZ = "org.bluez"
AGENT_PATH = APP_PATH + "/iwd_agent"
AGENT_XML = """
<node>
  <interface name="net.connman.iwd.Agent">
    <method name="Release"/>
    <method name="RequestPassphrase"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
    <method name="RequestPrivateKeyPassphrase"><arg type="o" direction="in"/><arg type="s" direction="out"/></method>
    <method name="RequestUserNameAndPassword"><arg type="o" direction="in"/><arg type="s" direction="out"/><arg type="s" direction="out"/></method>
    <method name="RequestUserPassword"><arg type="o" direction="in"/><arg type="s" direction="in"/><arg type="s" direction="out"/></method>
    <method name="Cancel"><arg type="s" direction="in"/></method>
  </interface>
</node>
"""

