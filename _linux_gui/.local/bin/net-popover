BT_ICONS = {
    "audio-headset": "\U000f02cb",  # nf-md-headphones
    "audio-headphones": "\U000f02cb",
    "audio-card": "\U000f04c3",  # nf-md-speaker
    "input-mouse": "\U000f037d",  # nf-md-mouse
    "input-keyboard": "\U000f030c",  # nf-md-keyboard
    "input-gaming": "\U000f0296",  # nf-md-gamepad
    "phone": "\U000f011c",  # nf-md-cellphone
    "computer": "\U000f0322",  # nf-md-laptop
}
BT_DEFAULT = "\U000f00af"  # nf-md-bluetooth
BATTERY = ["\U000f007a", "\U000f007b", "\U000f007c", "\U000f007d", "\U000f007e",
           "\U000f007f", "\U000f0080", "\U000f0081", "\U000f0082", "\U000f0079"]  # nf-md-battery_10..100

