theme=catppuccin-macchiato.conf
font-size = 20
font-family = "Fira Code"
font-thicken = true
#font-style = "Regular"
clipboard-read = allow
clipboard-write = allow
copy-on-select = true
clipboard-paste-protection = false
confirm-close-surface = false
shell-integration-features = sudo
term="xterm-256color"

keybind = shift+enter=text:\x1b\r


# Disable splits and tabs we are cool and use tmux
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+t=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
window-save-state = "never"
# Optional: Make it even cleaner
window-decoration = false

bell-features = system,audio,attention,title,border
# `audio` does nothing without an explicit file; `system` alone is a
# GTK beep that Hyprland has no sound theme for.
# The file carries 2s of leading silence on purpose: pipewire suspends idle
# sinks and the default one is bluetooth, so a bare 0.14s bell plays entirely
# into an A2DP link that hasn't woken up yet and is never heard.
bell-audio-path = bell-attention.oga
bell-audio-volume = 0.4

