{
  "build": {
    "context": "..",
    "dockerfile": "base/Dockerfile"
  },
  // The whole home directory lives in a named volume, one per project, so
  // every login made inside the container (Claude, gh, gcloud, ...) survives
  // --recreate. Its files are stored in .devcontainer-home/ next to the
  // project (prepare-home.sh creates it), so a project in an encrypted folder
  // keeps them encrypted. The bind mounts below are layered on top of it.
  "mounts": [
    "source=devcontainer-homedir-${devcontainerId},target=/home/vscode,type=volume,volume-opt=type=none,volume-opt=o=bind,volume-opt=device=${localWorkspaceFolder}/../.devcontainer-home/${localWorkspaceFolderBasename}",
    "source=${localWorkspaceFolder}/.devcontainer/configs/ssh.config,target=/home/vscode/.ssh/config,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.secrets/home/.ssh/KEY.pub,target=/home/vscode/.ssh/KEY.pub,type=bind,consistency=cached",
    "source=${localEnv:HOME}/dotfiles,target=/home/vscode/dotfiles,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/ccstatusline/,target=/home/vscode/.config/ccstatusline/,type=bind,consistency=cached",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    // The host's runtime dir, for its Wayland socket: wl-paste in the
    // container then reads the host clipboard, so a screenshot pastes into
    // Claude. The whole dir rather than the socket file, so a compositor
    // restart doesn't leave a stale socket behind.
    "source=${localEnv:XDG_RUNTIME_DIR},target=/run/host-xdg,type=bind"
  ],
  "runArgs": [
    "--network=host"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "WAYLAND_DISPLAY": "/run/host-xdg/${localEnv:WAYLAND_DISPLAY}"
  },
  // Claude's notification hooks run non-interactively, so they never source
  // ~/.secrets/secrets.zsh the way a login shell does. Hand the keys in
  // directly; devshell runs from an interactive shell that already has them.
  "remoteEnv": {
    "PUSHOVER_USER_KEY": "${localEnv:PUSHOVER_USER_KEY}",
    "PUSHOVER_CLAUDE_API_KEY": "${localEnv:PUSHOVER_CLAUDE_API_KEY}",
    "PUSHOVER_GENERAL_API_KEY": "${localEnv:PUSHOVER_GENERAL_API_KEY}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {  "moby": false },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "initializeCommand": "mkdir -p $HOME/dotfiles $HOME/.config/ccstatusline && \"${localWorkspaceFolder}/.devcontainer/base/host-scripts/prepare-home.sh\" \"${localWorkspaceFolder}\"",
  "postStartCommand": ".devcontainer/base/scripts/post-start.sh",
  "postCreateCommand": ".devcontainer/base/scripts/post-create.sh"
}

