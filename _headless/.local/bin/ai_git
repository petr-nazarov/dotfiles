#!/bin/bash
#
# ai_git — commit the staged changes with an AI-generated message.
#
#   ai_git            generate the message, open it in $EDITOR before committing
#   ai_git sync       accept the generated message as-is, then pull && push
#   ai_git -y         accept the generated message as-is, commit only
#
# notify-attention rings the tmux pane (and logs) when the run finishes.

set -uo pipefail

EDIT=1
SYNC=0

usage() {
	sed -n '2,10p' "$0" | sed 's/^#\s\?//'
	exit "${1:-0}"
}

for arg in "$@"; do
	case "$arg" in
	sync) SYNC=1; EDIT=0 ;;
	-y | --yes | --no-edit) EDIT=0 ;;
	-h | --help) usage ;;
	*)
		echo "ai_git: unknown argument: $arg (try --help)" >&2
		exit 1
		;;
	esac
done

# ---------------------------------------------------------------- notification
REPO=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")

notify() {
	# notify <title> <message>
	command -v notify-attention >/dev/null 2>&1 || return 0
	# </dev/null: notify-attention drains stdin looking for a Claude hook
	# payload, and would otherwise wait on whatever it inherited from us.
	notify-attention "$1" "$2" </dev/null >/dev/null 2>&1 || true
}

fail() {
	echo "$1" >&2
	notify "git ai failed: $REPO" "$1"
	exit 1
}

# 1. Use --cached to see what you are actually about to commit
# If you use 'git diff' without --cached, it looks at unstaged changes,
# but 'git commit' only commits staged changes!
DIFF_CONTENT=$(git diff --cached)

if [ -z "$DIFF_CONTENT" ]; then
	echo "No staged changes found. Use 'git add' first."
	exit 1
fi

echo "Generating Git Commit Message:"
GIT_MESSAGE=$(unfabric -p create_git_commit_message_from_diff "$DIFF_CONTENT") ||
	fail "could not generate a commit message"

[ -n "$GIT_MESSAGE" ] || fail "the generated commit message was empty"

# 3. Create a temp file
TEMP_MSG_FILE=$(mktemp)
echo "$GIT_MESSAGE" >"$TEMP_MSG_FILE"

# 4. The Magic Command
# -F takes the message from the file
# -e opens your editor (Neovim/Vim) so you can edit it
if [ "$EDIT" -eq 1 ]; then
	git commit -e -F "$TEMP_MSG_FILE"
else
	git commit -F "$TEMP_MSG_FILE"
fi
COMMIT_STATUS=$?

# 5. Cleanup
rm "$TEMP_MSG_FILE"

[ "$COMMIT_STATUS" -eq 0 ] || fail "commit failed (or was aborted)"

BRANCH=$(git rev-parse --abbrev-ref HEAD)
SUBJECT=$(git log -1 --pretty=%s)

# 6. sync: bring the branch up to date and publish it
if [ "$SYNC" -eq 1 ]; then
	git pull || fail "pull failed after committing: $SUBJECT"
	git push || fail "push failed after committing: $SUBJECT"
	notify "git ai sync: $REPO · $BRANCH" "pushed: $SUBJECT"
else
	notify "git ai: $REPO · $BRANCH" "committed: $SUBJECT"
fi
