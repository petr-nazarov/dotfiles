#!/usr/bin/env zsh

## Report or toggle the tailscale connection.
##   status  print waybar JSON (default)
##   toggle  bring tailscale up/down via pkexec and refresh waybar
##
## Prints an empty module (waybar hides it) when tailscale is not installed
## or the daemon cannot be reached.

hide() {
	print -r -- '{"text":""}'
	exit 0
}

report() {
	## $1 glyph, $2 css class, $3 tooltip
	print -r -- "{\"text\":\"$1\",\"class\":\"$2\",\"tooltip\":\"$3\"}"
	exit 0
}

## echo the BackendState, or nothing when tailscale is unavailable
backend_state() {
	command -v tailscale >/dev/null || return 1
	## bail out rather than stall the bar if tailscaled is wedged
	local json
	json=$(timeout 2 tailscale status --json 2>/dev/null) || return 1
	print -r -- "$json" |
		grep -o '"BackendState"[[:space:]]*:[[:space:]]*"[^"]*"' |
		head -n1 |
		sed 's/.*"\([^"]*\)"$/\1/'
}

case "${1:-status}" in
toggle)
	state=$(backend_state) || exit 0
	if [[ "$state" == "Running" ]]; then
		out=$(pkexec "$(command -v tailscale)" down 2>&1)
	else
		out=$(pkexec "$(command -v tailscale)" up 2>&1)
	fi
	## surface auth URLs and permission failures, which are otherwise invisible
	[[ -n "$out" ]] && notify-send "Tailscale" "$out"
	pkill -RTMIN+9 waybar
	;;
status)
	state=$(backend_state) || hide

	case "$state" in
	Running)
		ip=$(timeout 2 tailscale ip -4 2>/dev/null | head -n1)
		report "󰖂" "connected" "Tailscale connected${ip:+\\n$ip}\\nClick to disconnect"
		;;
	Starting)
		report "󰖂" "connecting" "Tailscale connecting…"
		;;
	NeedsLogin | NeedsMachineAuth)
		report "󰖂" "disconnected" "Tailscale needs login\\nClick to connect"
		;;
	Stopped | NoState)
		report "󰖂" "disconnected" "Tailscale disconnected\\nClick to connect"
		;;
	esac

	hide
	;;
esac
