#!/usr/bin/env zsh
#
# notify-attention <title> <message>
# notify-attention --busy | --idle
#
# Rings the tmux pane Claude is working in, so its window gets the red bell
# badge. --busy / --idle instead set or clear the yellow "Claude is working"
# badge (see mark_pane below), without the bell's grace period. The Pushover push is commented out for now (see "send" at the bottom);
# the title/message plumbing is kept intact so it can be switched back on.
#
# Claude Code hands its hooks a JSON payload on stdin. When we detect one we
# ignore the caller's title and build our own from where Claude is actually
# working — repo, worktree, branch, path, tmux session — so a phone full of
# "needs your input" pings still tells you *which* session wants you.
# Called by hand (or by the sunshine scripts) the plain title/message wins.

emulate -L zsh

MODE=''
[[ $1 == --busy || $1 == --idle ]] && { MODE=${1#--}; shift }

TITLE=${1:-Notification}
TEXT=${2:-}

LOG=${NOTIFY_ATTENTION_LOG:-$HOME/.local/state/notify-attention.log}

logline() {
  [[ -d ${LOG:h} ]] || mkdir -p ${LOG:h} 2>/dev/null
  print -r -- "$(date '+%F %T') $*" >>$LOG 2>/dev/null
}

# if [[ "$(uname)" == "Darwin" ]]; then
# 	afplay /System/Library/Sounds/Glass.aiff
# 	osascript -e "display notification \"$TEXT\" with title \"$TITLE\""
# else
#   if [[ -z "$container" ]]; then
#       paplay /usr/share/sounds/freedesktop/stereo/window-attention.oga 2>/dev/null
#       notify-send "$TITLE" "$TEXT" 2>/dev/null
#   fi
# fi

# --------------------------------------------------------------- hook payload
# timeout: never let an inherited-but-idle stdin wedge a notification.
payload=''
[[ -t 0 ]] || payload=$(timeout 1 cat 2>/dev/null)

event='' hook_msg='' cwd=''
if [[ -n $payload ]] && (( ${+commands[jq]} )); then
  # one field per jq call on purpose: a single delimited read would either
  # collapse empty fields (tab is IFS whitespace) or choke on a multi-line
  # .message
  jq_get() { print -r -- "$payload" | jq -r "$1 // empty" 2>/dev/null }
  event=$(jq_get .hook_event_name)
  hook_msg=$(jq_get .message)
  cwd=$(jq_get .cwd)
fi

# ------------------------------------------------------------------- context
# "repo · branch", or "repo:worktree · branch" inside a linked worktree.
git_context() {
  local dir=$1 top gitdir common repo branch wt
  git -C $dir rev-parse --is-inside-work-tree &>/dev/null || { print -r -- ${dir:t}; return }

  top=$(git -C $dir rev-parse --show-toplevel 2>/dev/null)
  gitdir=$(git -C $dir rev-parse --absolute-git-dir 2>/dev/null)
  common=$(git -C $dir rev-parse --git-common-dir 2>/dev/null)
  [[ $common == /* ]] || common=$dir/$common
  common=${common:A}

  # <repo>/.git -> <repo>; a worktree's common dir still points at the main one
  repo=${${common:h}:t}
  branch=$(git -C $dir branch --show-current 2>/dev/null)
  [[ -n $branch ]] || branch="detached@$(git -C $dir rev-parse --short HEAD 2>/dev/null)"
  [[ ${gitdir:A} != $common ]] && wt=${top:t}

  print -r -- "${repo}${wt:+:$wt} · ${branch}"
}

# Ring the pane Claude is in, so tmux raises window_bell_flag on the right
# window. The hook's stdout belongs to Claude, not the terminal, so we have to
# write the BEL into the pane's tty directly.
#
# Claude spawns hooks with no controlling terminal (tty_nr is 0), so /dev/tty
# is never an option. Walk up to the nearest ancestor that does own one -
# claude itself - and ring its stdout. In a devcontainer there is no tmux
# socket either, but claude's stdout is the docker exec pty whose far end is
# the host pane, so the BEL still reaches tmux.
ancestor_tty() {
  local pid=$PPID depth=0 fd
  while (( depth++ < 12 )) && [[ -r /proc/$pid/stat ]]; do
    fd=/proc/$pid/fd/1
    [[ -c $fd && -w $fd ]] && { print -r -- $fd; return }
    # strip "pid (comm) " first: comm may contain spaces or parens
    pid=$(sed -E 's/^[0-9]+ \(.*\) //' /proc/$pid/stat 2>/dev/null | awk '{print $2}')
    [[ -n $pid && $pid != 0 && $pid != 1 ]] || return
  done
}

pane_tty() {
  local tty=''
  if [[ -n ${TMUX-} ]] && (( ${+commands[tmux]} )); then
    tty=$(tmux display-message -p ${TMUX_PANE:+-t} ${TMUX_PANE:-} '#{pane_tty}' 2>/dev/null)
  fi
  [[ -n $tty && -w $tty ]] || tty=$(ancestor_tty)
  [[ -n $tty && -w $tty ]] && print -r -- $tty
}

ring_pane() {
  local tty=$(pane_tty)
  [[ -n $tty ]] && printf '\a' >$tty
}

# The busy badge rides the same pty as the bell, so it crosses docker exec and
# ssh too. It is an OSC 7 ("current directory") report: tmux keeps the last one
# in #{pane_path}, which nothing else here uses - new panes and splits follow
# #{pane_current_path}, which OSC 7 leaves alone. .tmux.conf paints any pane
# whose pane_path mentions claude-busy; an empty report clears it again.
mark_pane() {
  local tty=$(pane_tty)
  [[ -n $tty ]] || return
  if [[ $1 == busy ]]; then
    # a fresh stamp per mark, so tmux can tell this turn from an interrupted one
    zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null
    printf '\e]7;file://claude-busy/%s\e\\' ${EPOCHREALTIME:-$RANDOM} >$tty
  else
    printf '\e]7;\e\\' >$tty
  fi
}

tmux_context() {
  [[ -n ${TMUX-} ]] && (( ${+commands[tmux]} )) || return
  tmux display-message -p ${TMUX_PANE:+-t} ${TMUX_PANE:-} '#S:#I' 2>/dev/null
}

if [[ -n $MODE ]]; then
  # A question or a plan waiting for approval is Claude waiting on you, not
  # working, even though it arrives as a PreToolUse like any other tool.
  [[ $payload == *'"tool_name":'(|' ')'"'(AskUserQuestion|ExitPlanMode)'"'* ]] && MODE=idle
  mark_pane $MODE
  exit 0
fi

if [[ -n $event ]]; then
  # Claude is done or blocked on you: drop the busy badge at once, the bell
  # follows after the grace period
  mark_pane idle
  [[ -n $cwd && -d $cwd ]] || cwd=$PWD
  TITLE=$(git_context $cwd)
  # the hook's own message ("Claude needs your permission to use Bash") beats
  # whatever static string settings.json passed us
  [[ -n $hook_msg ]] && TEXT=$hook_msg
  [[ -n $TEXT ]] || TEXT=$event
  # grace period: ringing the window you are still staring at just clears the
  # flag again, so give yourself a moment to tab away first
  sleep 4
  ring_pane
  # a push from a container otherwise looks identical to one from the host
  [[ -f /.dockerenv ]] && TITLE="\U1F433 $TITLE"
  where=${cwd/#$HOME/\~}
  tm=$(tmux_context)
  TEXT="${TEXT}"$'\n'"${where}${tm:+ · tmux ${tm}}"
fi

# ---------------------------------------------------------------------- send
logline "bell: $TITLE | ${TEXT%%$'\n'*}"

# Pushover disabled for now — the tmux bell above carries the signal. Uncomment
# to start pushing to the phone/browser again.
#
