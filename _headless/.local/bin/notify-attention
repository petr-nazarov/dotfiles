#   ntf_args=(-q -c "${NTF_CHANNEL:-claude}" -d "${NTF_DEVICE:-browser}")
#   if [[ -n $TEXT ]]; then
#     ntf_args+=(-t "$TITLE" -m "$TEXT")
#   else
#     ntf_args+=(-m "$TITLE")
#   fi
#   logline "sent: $TITLE | ${TEXT%%$'\n'*}"
#   # </dev/null: we already drained stdin, and ntf would read whatever is left
#   # as its message body. Failures land in $LOG instead of /dev/null.
#   {
#     ntf "${ntf_args[@]}" </dev/null 2>>$LOG || logline "ntf failed (exit $?): $TITLE / ${TEXT%%$'\n'*}"
#   } &!
# else
#   logline "ntf not found in PATH; dropped: $TITLE / ${TEXT%%$'\n'*}"
# fi
