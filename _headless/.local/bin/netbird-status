#!/usr/bin/env zsh

## Report or toggle the netbird connection.
##   status  print waybar JSON (default)
##   toggle  bring netbird up/down and refresh waybar
##   profile pick a profile with tofi, switch to it and reconnect
##
## Prints an empty module (waybar hides it) when netbird is not installed
## or the daemon cannot be reached.

hide() {
	print -r -- '{"text":""}'
	exit 0
}

report() {
	## $1 glyph, $2 css class, $3 tooltip; non-default profiles get an extra class
	local class="\"$2\"" tooltip="$3"
	if [[ -n "$profile" ]]; then
		tooltip+="\\nProfile: $profile"
		[[ "$profile" != "default" ]] && class="[$class,\"alt-profile\"]"
	fi
	tooltip+="\\nRight-click to switch profile"
	print -r -- "{\"text\":\"$1\",\"class\":$class,\"tooltip\":\"$tooltip\"}"
	exit 0
}

## echo the raw status JSON, or nothing when netbird is unavailable
status_json() {
	command -v netbird >/dev/null || return 1
	## bail out rather than stall the bar if the daemon is wedged
	timeout 2 netbird status --json 2>/dev/null
}

## echo the daemonStatus from the status JSON in $1
daemon_status() {
	print -r -- "$1" |
		grep -o '"daemonStatus"[[:space:]]*:[[:space:]]*"[^"]*"' |
		head -n1 |
		sed 's/.*"\([^"]*\)"$/\1/'
}

## echo the active profile name
active_profile() {
	print -r -- "$1" |
		grep -o '"profileName"[[:space:]]*:[[:space:]]*"[^"]*"' |
		head -n1 |
		sed 's/.*"\([^"]*\)"$/\1/'
}

## the daemon socket is usually world-writable, so only escalate when it is not
run_netbird() {
	local out
	if out=$(netbird "$@" 2>&1); then
		print -r -- "$out"
		return 0
	fi
	if [[ "$out" == *[Pp]ermission* || "$out" == *denied* ]]; then
		pkexec "$(command -v netbird)" "$@" 2>&1
	else
		print -r -- "$out"
	fi
}

case "${1:-status}" in
toggle)
	json=$(status_json) || exit 0
	state=$(daemon_status "$json")
	if [[ "$state" == "Connected" ]]; then
		out=$(run_netbird down)
	else
		out=$(run_netbird up)
	fi
	## surface auth URLs and failures, which are otherwise invisible
	profile=$(active_profile "$(status_json)")
	notify-send "NetBird${profile:+ ($profile)}" "${out:-done}"
	pkill -RTMIN+10 waybar
	;;
profile)
	json=$(status_json) || exit 0
	state=$(daemon_status "$json")
	## `netbird profile list` prints a NAME/ACTIVE table; mark the active row
	choice=$(timeout 2 netbird profile list 2>/dev/null |
		awk 'NR > 1 && NF { print ($2 == "✓" ? "✓ " : "  ") $1 }' |
		tofi --prompt-text "NetBird profile: ") || exit 0
	choice=${choice#??}
	[[ -z "$choice" ]] && exit 0
	[[ "$state" == "Connected" || "$state" == "Connecting" ]] && run_netbird down >/dev/null
	out=$(run_netbird profile select "$choice") &&
		out+=$'\n'$(run_netbird up)
	notify-send "NetBird ($choice)" "$out"
	pkill -RTMIN+10 waybar
	;;
status)
	json=$(status_json) || hide
	state=$(daemon_status "$json")
	profile=$(active_profile "$json")

	case "$state" in
	Connected)
		ip=$(timeout 2 netbird status 2>/dev/null | sed -n 's|^NetBird IP:[[:space:]]*\([^/]*\).*|\1|p' | head -n1)
		report "󱗆" "connected" "NetBird connected${ip:+\\n$ip}\\nClick to disconnect"
		;;
	Connecting)
		report "󱗆" "connecting" "NetBird connecting…"
		;;
	NeedsLogin | LoginFailed | SessionExpired)
		report "󱗆" "disconnected" "NetBird needs login\\nClick to connect"
		;;
	Idle | Disconnected)
		report "󱗆" "disconnected" "NetBird disconnected\\nClick to connect"
		;;
	esac

	hide
	;;
esac
